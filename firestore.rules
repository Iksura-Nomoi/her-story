rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- DevTools password hash -------------------------------------
    // NOT client-readable. The password check now happens server-side
    // in the checkDevToolsPassword Cloud Function (functions/index.js),
    // which uses the Admin SDK and bypasses these rules entirely — that
    // is the only thing that can ever read this document. You set/change
    // it only from the Firebase Console or Admin SDK/CLI — never from
    // the game itself.
    match /_config/devtools {
      allow read: if false;
      allow write: if false;
    }

    // Rate-limit bookkeeping for the password check — Admin SDK only.
    match /_config/devtools_attempts/{doc=**} {
      allow read, write: if false;
    }

    // Block every other _config doc by default.
    match /_config/{doc} {
      allow read, write: if false;
    }

    // --- Player stats (operator name, play time, progression) --------
    // Anyone can write their OWN stats doc (docId == operatorName), but
    // cannot read anyone's stats back, and cannot write arbitrary junk —
    // this constrains shape/size so a malicious client can't stuff huge
    // or malformed payloads into your database.
    match /player_stats/{operatorName} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(
                                ['operatorName', 'firstLaunch', 'playTimeSeconds',
                                 'currentCase', 'completedCaseCount', 'updatedAt'])
                             && request.resource.data.operatorName is string
                             && request.resource.data.operatorName.size() < 100
                             && request.resource.data.playTimeSeconds is number
                             && request.resource.data.playTimeSeconds >= 0
                             && request.resource.data.playTimeSeconds < 100000000
                             && request.resource.data.completedCaseCount is number
                             && request.resource.data.completedCaseCount >= 0
                             && request.resource.data.completedCaseCount <= 10;
      allow delete: if false;
    }

    // --- Operator registration ----------------------------------------
    match /operators/{docId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'registeredAt'])
                     && request.resource.data.name is string
                     && request.resource.data.name.size() > 0
                     && request.resource.data.name.size() < 100;
      allow update, delete: if false;
    }

    // --- End-of-campaign reviews ---------------------------------------
    match /reviews/{docId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['operatorName', 'stars', 'review', 'feedback', 'timestamp'])
                     && request.resource.data.stars is number
                     && request.resource.data.stars >= 1
                     && request.resource.data.stars <= 5
                     && request.resource.data.review is string
                     && request.resource.data.review.size() < 2000
                     && request.resource.data.feedback is string
                     && request.resource.data.feedback.size() < 2000;
      allow update, delete: if false;
    }

    // Deny everything else by default (belt-and-suspenders — Firestore
    // already denies anything not explicitly allowed above, but this
    // makes the "closed by default" intent explicit for anyone reading
    // these rules later).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
